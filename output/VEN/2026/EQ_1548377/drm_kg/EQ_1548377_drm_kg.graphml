<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
<key id="n_label" for="node" attr.name="label" attr.type="string"/>
<key id="n_type" for="node" attr.name="type" attr.type="string"/>
<key id="n_drm_phase" for="node" attr.name="drm_phase" attr.type="string"/>
<key id="n_description" for="node" attr.name="description" attr.type="string"/>
<key id="e_relation" for="edge" attr.name="relation" attr.type="string"/>
<key id="e_drm_phase" for="edge" attr.name="drm_phase" attr.type="string"/>
<key id="e_status" for="edge" attr.name="status" attr.type="string"/>
<key id="e_confidence" for="edge" attr.name="confidence" attr.type="string"/>
<key id="e_explanation" for="edge" attr.name="explanation" attr.type="string"/>
<graph edgedefault="directed">
<node id="eq_foreshock_m72"><data key="n_label">M7.2 foreshock San Felipe</data><data key="n_type">hazard</data><data key="n_drm_phase">none</data><data key="n_description">Magnitude 7.2 shallow foreshock near San Felipe, Yaracuy, 22 km depth, 24 June 2026.</data></node>
<node id="eq_mainshock_m75"><data key="n_label">M7.5 mainshock Yumare</data><data key="n_type">hazard</data><data key="n_drm_phase">none</data><data key="n_description">Magnitude 7.5 shallow mainshock near Yumare, Veroes, Yaracuy, 10 km depth, 39-40s after foreshock.</data></node>
<node id="aftershocks"><data key="n_label">Extensive aftershock sequence</data><data key="n_type">hazard</data><data key="n_drm_phase">none</data><data key="n_description">Over 1,000 aftershocks recorded by mid-July, including M5.1 Tucacas and M4.4 Guatire events, continuing to weaken structures.</data></node>
<node id="landslide_risk"><data key="n_label">Landslide/debris-flow risk from rains</data><data key="n_type">hazard</data><data key="n_drm_phase">none</data><data key="n_description">Onset of rainy season, hurricanes or tropical lows could trigger landslides and mud flows on seismically weakened slopes in North Coastal Range.</data></node>
<node id="disease_outbreak_risk"><data key="n_label">Risk of disease outbreaks</data><data key="n_type">hazard</data><data key="n_drm_phase">none</data><data key="n_description">PAHO identified elevated risk of measles, diphtheria, pertussis, polio, acute diarrheal disease, cholera and vector-borne illness linked to displacement and damaged WASH.</data></node>
<node id="deaths"><data key="n_label">Deaths from earthquakes</data><data key="n_type">impact</data><data key="n_drm_phase">none</data><data key="n_description">Death toll rose from 32 to over 5,200 across successive reports (DFS, OCHA, UNHCR, UNFPA, UNICEF, CESVI).</data></node>
<node id="injuries"><data key="n_label">Injuries from earthquakes</data><data key="n_type">impact</data><data key="n_drm_phase">none</data><data key="n_description">Injuries rose from about 700 to over 16,700 across multiple situation reports.</data></node>
<node id="missing_persons"><data key="n_label">Tens of thousands missing</data><data key="n_type">impact</data><data key="n_drm_phase">none</data><data key="n_description">IFRC noted tens of thousands reported missing, with ambiguous unreconciled figures across sources.</data></node>
<node id="displacement"><data key="n_label">Mass displacement/homelessness</data><data key="n_type">impact</data><data key="n_drm_phase">none</data><data key="n_description">Displacement estimates rose from 3,000 (OCHA) to over 17,900 homeless (UNICEF/CESVI) with people in temporary camps.</data></node>
<node id="collapsed_structures"><data key="n_label">Collapsed/damaged buildings</data><data key="n_type">impact</data><data key="n_drm_phase">none</data><data key="n_description">2,501 damaged sites including 774 housing units, 189 fully collapsed, and 38 hospitals (UNHCR); CESVI cites 856 affected buildings.</data></node>
<node id="economic_losses"><data key="n_label">US$6.7-37 billion economic damage</data><data key="n_type">impact</data><data key="n_drm_phase">none</data><data key="n_description">UNDP preliminary estimate of $6.7bn direct physical damage; UNDRR analytical estimate of ~$37bn total direct damage to buildings and infrastructure.</data></node>
<node id="infrastructure_disruption"><data key="n_label">Critical infrastructure disruption</data><data key="n_type">impact</data><data key="n_drm_phase">none</data><data key="n_description">Closure of Maiquetía airport, suspension of Caracas Metro/railways, power outages, damage to water, telecoms, roads and bridges.</data></node>
<node id="health_system_strain"><data key="n_label">Overwhelmed health system</data><data key="n_type">impact</data><data key="n_drm_phase">none</data><data key="n_description">Hospitals managing large trauma caseloads within an already weakened health system with pre-crisis shortages of supplies and surgical capacity.</data></node>
<node id="livelihood_loss"><data key="n_label">Loss of livelihoods/income</data><data key="n_type">impact</data><data key="n_drm_phase">none</data><data key="n_description">Households lost homes, productive assets, employment; small businesses, informal commerce and tourism severely disrupted (IFRC).</data></node>
<node id="protection_risks"><data key="n_label">Heightened protection risks</data><data key="n_type">impact</data><data key="n_drm_phase">none</data><data key="n_description">Overcrowded shelters, family separation and displacement increased GBV and protection risks especially for women, girls, disabled and older persons (UNFPA).</data></node>
<node id="logistics_congestion"><data key="n_label">Logistics congestion at ports/airport</data><data key="n_type">impact</data><data key="n_drm_phase">none</data><data key="n_description">Damaged Maiquetía airport and concentration of operations at Port of La Guaira increased risk of delays in receipt, storage and distribution of supplies.</data></node>
<node id="vuln_unreinforced_construction"><data key="n_label">Unreinforced/informal construction</data><data key="n_type">vulnerability</data><data key="n_drm_phase">none</data><data key="n_description">Most buildings unlikely built to modern earthquake regulations; lack of enforcement of building standards; informal settlements on unstable hillsides.</data></node>
<node id="vuln_preexisting_crisis"><data key="n_label">Protracted economic/humanitarian crisis</data><data key="n_type">vulnerability</data><data key="n_drm_phase">none</data><data key="n_description">Venezuela ranked 24th/97 on INFORM Severity Index (7.6/10), nearly 8 million already in humanitarian need before the quakes.</data></node>
<node id="vuln_poverty"><data key="n_label">High poverty/multidimensional poverty</data><data key="n_type">vulnerability</data><data key="n_drm_phase">none</data><data key="n_description">94% poverty rate and 46% multidimensional poverty in La Guaira; over half population in extreme poverty nationally before quakes.</data></node>
<node id="vuln_weak_services"><data key="n_label">Weak pre-existing shelter/WASH/health systems</data><data key="n_type">vulnerability</data><data key="n_drm_phase">none</data><data key="n_description">REACH/ACAPS found weak shelter, water and health systems in Aragua, La Guaira, Carabobo, Falcón limiting absorptive capacity before the quakes.</data></node>
<node id="vuln_fragile_housing"><data key="n_label">Fragile housing stock</data><data key="n_type">vulnerability</data><data key="n_drm_phase">none</data><data key="n_description">62% of housing in fragile condition with repair needs in La Guaira; widespread housing deterioration reported pre-quake.</data></node>
<node id="vuln_workforce_gap"><data key="n_label">Workforce gaps from emigration</data><data key="n_type">vulnerability</data><data key="n_drm_phase">none</data><data key="n_description">Years of emigration (~8 million people) left critical workforce gaps impacting search-and-rescue and recovery capacity (IRC).</data></node>
<node id="vuln_low_protection_coverage"><data key="n_label">Low Protection Cluster coverage</data><data key="n_type">vulnerability</data><data key="n_drm_phase">none</data><data key="n_description">Protection Cluster had reached only 8% of its 1.9 million target population by April 2026.</data></node>
<node id="vuln_censorship"><data key="n_label">Censorship/limited transparency</data><data key="n_type">vulnerability</data><data key="n_drm_phase">none</data><data key="n_description">Censorship, limited transparency and restrictions on media/civil society weakened public trust in official information (ACAPS/Amnesty International).</data></node>
<node id="vuln_weak_health_system"><data key="n_label">Pre-crisis weak health system</data><data key="n_type">vulnerability</data><data key="n_drm_phase">none</data><data key="n_description">Public health system in protracted collapse with shortages of personnel, medicines, supplies and surgical capacity before the quakes.</data></node>
<node id="need_shelter"><data key="n_label">Need for safe temporary shelter</data><data key="n_type">need</data><data key="n_drm_phase">response</data><data key="n_description">Health Cluster identified critical need for safe temporary shelter amid families sleeping in streets, cars and makeshift tents.</data></node>
<node id="need_water_sanitation"><data key="n_label">Need for safe water and sanitation</data><data key="n_type">need</data><data key="n_drm_phase">response</data><data key="n_description">Water cited as top priority need nationally since March 2026; WASH gaps worsened post-quake per Health Cluster and Project HOPE.</data></node>
<node id="need_health_personnel"><data key="n_label">Need for specialized medical personnel/supplies</data><data key="n_type">need</data><data key="n_drm_phase">response</data><data key="n_description">Need for logistics support, specialized medical personnel, medicines and equipment flagged by Health Cluster and PAHO.</data></node>
<node id="need_mhpss"><data key="n_label">Need for mental health/psychosocial support</data><data key="n_type">need</data><data key="n_drm_phase">response</data><data key="n_description">Critical need for specialized MHPSS amid widespread fear, grief and distress; Project HOPE found significant MHPSS gaps.</data></node>
<node id="need_child_protection"><data key="n_label">Need for child protection pathways</data><data key="n_type">need</data><data key="n_drm_phase">response</data><data key="n_description">Need to activate protection pathways for unaccompanied children identified in health centers.</data></node>
<node id="need_srh_gbv"><data key="n_label">Need for SRH and GBV services</data><data key="n_type">need</data><data key="n_drm_phase">response</data><data key="n_description">UNFPA flagged unmet needs in survivor-centred GBV and SRH services amid overcrowded shelters and family separation.</data></node>
<node id="need_structural_assessment"><data key="n_label">Need for structural safety assessment</data><data key="n_type">need</data><data key="n_drm_phase">recovery</data><data key="n_description">Risk that buildings not collapsed sustained unseen structural damage, requiring assessment before safe return (ACAPS).</data></node>
<node id="need_logistics_coordination"><data key="n_label">Need for logistics coordination</data><data key="n_type">need</data><data key="n_drm_phase">response</data><data key="n_description">OCHA Logistics Working Group identified need for coordination given congestion at airport/port, fuel shortages and access constraints.</data></node>
<node id="need_livelihoods_investment"><data key="n_label">Need for livelihoods/economic investment</data><data key="n_type">need</data><data key="n_drm_phase">recovery</data><data key="n_description">IRC warned urgent investment in local economies and livelihoods is needed to prevent deepening crisis in early recovery window.</data></node>
<node id="need_landslide_monitoring"><data key="n_label">Need for landslide/rainfall monitoring</data><data key="n_type">need</data><data key="n_drm_phase">preparedness</data><data key="n_description">Shelter Cluster recommended daily monitoring of rainfall/landslide risk and landslide/debris-flow mapping in North Coastal Range.</data></node>
<node id="need_vaccine_security"><data key="n_label">Need for vaccine supply security</data><data key="n_type">need</data><data key="n_drm_phase">recovery</data><data key="n_description">PAHO identified need to restore routine immunization services, cold chain and vaccine supply given outbreak risk.</data></node>
<node id="need_registration_tracking"><data key="n_label">Need for casualty registration/tracking</data><data key="n_type">need</data><data key="n_drm_phase">response</data><data key="n_description">PAHO noted persistent gaps in registration and follow-up of injured/hospitalized patients causing underestimation of casualties.</data></node>
<node id="m_sar_operations"><data key="n_label">Search and rescue operations</data><data key="n_type">measure</data><data key="n_drm_phase">response</data><data key="n_description">Venezuelan Red Cross and international UNDAC/USAR teams under INSARAG conducted search and rescue from 24-25 June.</data></node>
<node id="m_state_emergency"><data key="n_label">National state of emergency declared</data><data key="n_type">measure</data><data key="n_drm_phase">response</data><data key="n_description">Government declared national state of emergency and designated La Guaira a disaster zone.</data></node>
<node id="m_access_restrictions"><data key="n_label">Temporary access restrictions La Guaira</data><data key="n_type">measure</data><data key="n_drm_phase">response</data><data key="n_description">Authorities imposed temporary access restrictions to La Guaira state from night of 26 June to prioritize search and rescue.</data></node>
<node id="m_health_cluster_activation"><data key="n_label">Expanded Health Cluster activation</data><data key="n_type">measure</data><data key="n_drm_phase">response</data><data key="n_description">Expanded Health Cluster co-led with MPPS activated 26 June to consolidate single response mechanism integrating state, UN and NGO actors.</data></node>
<node id="m_dref_emergency_appeal"><data key="n_label">IFRC DREF and Emergency Appeal</data><data key="n_type">measure</data><data key="n_drm_phase">response</data><data key="n_description">IFRC allocated CHF 2 million DREF and launched CHF 50-55 million Emergency Appeal targeting 300,000 people.</data></node>
<node id="m_field_hospital"><data key="n_label">Field hospital and operations centre</data><data key="n_type">measure</data><data key="n_drm_phase">response</data><data key="n_description">Venezuelan Red Cross set up field hospital at Jorge García Carmeiro Stadium and a Field Operations Centre.</data></node>
<node id="m_unhcr_protection_shelter"><data key="n_label">UNHCR protection and shelter support</data><data key="n_type">measure</data><data key="n_drm_phase">response</data><data key="n_description">UNHCR seeking $14.8-14.85M to support 30,000 people with protection, core relief items and shelter, including multi-service centres.</data></node>
<node id="m_unfpa_srh_gbv_response"><data key="n_label">UNFPA SRH/GBV response scale-up</data><data key="n_type">measure</data><data key="n_drm_phase">response</data><data key="n_description">UNFPA scaling up life-saving SRH and GBV prevention/response services targeting 64,000-230,000 people.</data></node>
<node id="m_unicef_response"><data key="n_label">UNICEF earthquake response appeal</data><data key="n_type">measure</data><data key="n_drm_phase">response</data><data key="n_description">UNICEF requested $65.7M to reach 470,000 people including 167,000 children, addressing health, WASH, protection and education needs.</data></node>
<node id="m_ngo_relief"><data key="n_label">NGO emergency relief mobilization</data><data key="n_type">measure</data><data key="n_drm_phase">response</data><data key="n_description">MSF, Good Neighbors, CESVI, Project HOPE/Proyecto Esperanza and Turkish Red Crescent mobilized relief, health posts and needs assessments.</data></node>
<node id="m_logistics_working_group"><data key="n_label">OCHA Logistics Working Group services</data><data key="n_type">measure</data><data key="n_drm_phase">response</data><data key="n_description">LWG provides shared logistics services, transport, storage and information on access conditions, with $0.8M budget.</data></node>
<node id="m_paho_medical_supplies"><data key="n_label">PAHO/WHO medical supply delivery</data><data key="n_type">measure</data><data key="n_drm_phase">response</data><data key="n_description">PAHO/WHO delivered medical supplies and equipment including to Maternal and Child Hospital Leopoldo Aguerrevere.</data></node>
<node id="m_needs_assessments"><data key="n_label">Rapid needs assessments</data><data key="n_type">measure</data><data key="n_drm_phase">response</data><data key="n_description">UNDAC, REACH, Project HOPE and other partners conducted rapid needs assessments of health, shelter and WASH conditions.</data></node>
<node id="m_hrp_addendum"><data key="n_label">HRP Addendum and sector planning</data><data key="n_type">measure</data><data key="n_drm_phase">recovery</data><data key="n_description">OCHA Humanitarian Response Plan Addendum and UNICEF HAC Appeal Addendum outline sector plans targeting 1.3 million affected people across 7 states.</data></node>
<node id="m_health_facility_rehab"><data key="n_label">Health facility rehabilitation</data><data key="n_type">measure</data><data key="n_drm_phase">recovery</data><data key="n_description">Rehabilitation planning and restoration of ICU/maternity capacity at Hospital Dr. José Gregorio Hernández underway by 12 August.</data></node>
<node id="m_revolving_fund_vaccines"><data key="n_label">PAHO Revolving Fund credit line</data><data key="n_type">measure</data><data key="n_drm_phase">recovery</data><data key="n_description">USD 18 million PAHO Revolving Fund credit line to support national vaccine supply security.</data></node>
<node id="m_environmental_guidance"><data key="n_label">Environmental guidance for shelter response</data><data key="n_type">measure</data><data key="n_drm_phase">response</data><data key="n_description">Shelter Cluster/UNHCR recommended Sphere Standard 7 and ECHO Minimum Environmental Requirements for shelter siting, debris reuse and waste management.</data></node>
<node id="m_rainfall_landslide_monitoring"><data key="n_label">Daily rainfall/landslide monitoring</data><data key="n_type">measure</data><data key="n_drm_phase">preparedness</data><data key="n_description">Recommended daily monitoring of rainfall and landslide risk, plus landslide/debris-flow mapping in North Coastal Range.</data></node>
<node id="m_tsunami_advisory"><data key="n_label">Caribbean tsunami advisory</data><data key="n_type">measure</data><data key="n_drm_phase">response</data><data key="n_description">A brief Caribbean tsunami advisory was issued and cancelled within about an hour, indicating some monitoring capacity was operational.</data></node>
<node id="m_livelihoods_investment"><data key="n_label">Livelihoods/economic recovery investment</data><data key="n_type">measure</data><data key="n_drm_phase">recovery</data><data key="n_description">IRC recommends urgent investment in local economies and livelihood support during early recovery window.</data></node>
<node id="m_building_code_enforcement"><data key="n_label">Building code enforcement (lacking)</data><data key="n_type">measure</data><data key="n_drm_phase">prevention</data><data key="n_description">ACAPS notes lack of enforcement of building standards; no retrofitting or land-use planning programmes described prior to the event.</data></node>
<node id="act_venezuelan_red_cross"><data key="n_label">Venezuelan Red Cross</data><data key="n_type">actor</data><data key="n_drm_phase">none</data><data key="n_description">National Red Cross society conducting SAR, health posts and receiving DREF funding.</data></node>
<node id="act_ifrc"><data key="n_label">IFRC</data><data key="n_type">actor</data><data key="n_drm_phase">none</data><data key="n_description">International Federation of Red Cross and Red Crescent Societies supporting Venezuelan Red Cross with funding and appeals.</data></node>
<node id="act_unhcr"><data key="n_label">UNHCR</data><data key="n_type">actor</data><data key="n_drm_phase">none</data><data key="n_description">UN Refugee Agency scaling up protection and shelter response.</data></node>
<node id="act_unfpa"><data key="n_label">UNFPA</data><data key="n_type">actor</data><data key="n_drm_phase">none</data><data key="n_description">UN Population Fund scaling up SRH and GBV response.</data></node>
<node id="act_unicef"><data key="n_label">UNICEF</data><data key="n_type">actor</data><data key="n_drm_phase">none</data><data key="n_description">UN Children's Fund providing child-focused humanitarian response.</data></node>
<node id="act_paho_who"><data key="n_label">PAHO/WHO</data><data key="n_type">actor</data><data key="n_drm_phase">none</data><data key="n_description">Pan American Health Organization/WHO co-leading Health Cluster and providing medical supplies.</data></node>
<node id="act_ocha"><data key="n_label">OCHA</data><data key="n_type">actor</data><data key="n_drm_phase">none</data><data key="n_description">UN Office for the Coordination of Humanitarian Affairs coordinating situation reports and logistics working group.</data></node>
<node id="act_undp"><data key="n_label">UNDP</data><data key="n_type">actor</data><data key="n_drm_phase">none</data><data key="n_description">UN Development Programme conducted RAPIDA damage assessment.</data></node>
<node id="act_shelter_cluster"><data key="n_label">Shelter Cluster/UNHCR</data><data key="n_type">actor</data><data key="n_drm_phase">none</data><data key="n_description">Shelter Cluster co-led by UNHCR issuing environmental guidance and shelter standards.</data></node>
<node id="act_ngos"><data key="n_label">International NGOs (MSF, CESVI, Project HOPE, Good Neighbors, Turkish Red Crescent)</data><data key="n_type">actor</data><data key="n_drm_phase">none</data><data key="n_description">International NGOs providing emergency relief, health services and needs assessments.</data></node>
<node id="act_irc"><data key="n_label">IRC</data><data key="n_type">actor</data><data key="n_drm_phase">none</data><data key="n_description">International Rescue Committee warning on economic recovery needs.</data></node>
<edge id="e0" source="eq_foreshock_m72" target="eq_mainshock_m75"><data key="e_relation">triggers</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">The M7.2 foreshock occurred about 39-40 seconds before the M7.5 mainshock on the same fault system.</data></edge>
<edge id="e1" source="eq_mainshock_m75" target="aftershocks"><data key="e_relation">triggers</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">The mainshock was followed by over 1,000 aftershocks recorded by mid-July, including notable M5.1 and M4.4 events.</data></edge>
<edge id="e2" source="eq_mainshock_m75" target="deaths"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Casualty figures rose steadily from the dual earthquake sequence per multiple agency sitreps.</data></edge>
<edge id="e3" source="eq_mainshock_m75" target="injuries"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Injury tolls rose across sitreps directly attributed to the earthquakes.</data></edge>
<edge id="e4" source="eq_mainshock_m75" target="collapsed_structures"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">UNHCR and OCHA reported thousands of damaged/collapsed structures caused by the earthquakes.</data></edge>
<edge id="e5" source="eq_mainshock_m75" target="infrastructure_disruption"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Airport closure, metro suspension, power outages and damage to water/telecoms/roads attributed to the earthquakes.</data></edge>
<edge id="e6" source="eq_mainshock_m75" target="economic_losses"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">UNDP and UNDRR estimated billions in direct physical damage from the earthquakes.</data></edge>
<edge id="e7" source="eq_mainshock_m75" target="displacement"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Families displaced from damaged or unsafe homes per UNHCR and UNFPA reporting.</data></edge>
<edge id="e8" source="collapsed_structures" target="displacement"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Damaged and collapsed housing left families homeless and seeking temporary shelter.</data></edge>
<edge id="e9" source="collapsed_structures" target="health_system_strain"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">38 hospitals reported damaged, compounding strain on an already weakened health system.</data></edge>
<edge id="e10" source="deaths" target="missing_persons"><data key="e_relation">amplifies</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">medium</data><data key="e_explanation">IFRC notes some missing persons figures may ultimately correspond to fatalities as registration progresses.</data></edge>
<edge id="e11" source="infrastructure_disruption" target="logistics_congestion"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Damage to Maiquetía airport and concentration at Port of La Guaira increased logistics congestion risk per OCHA LWG.</data></edge>
<edge id="e12" source="infrastructure_disruption" target="disease_outbreak_risk"><data key="e_relation">amplifies</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Damaged WASH systems and overcrowding increase risk of vaccine-preventable and water-borne disease outbreaks per PAHO.</data></edge>
<edge id="e13" source="aftershocks" target="landslide_risk"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">medium</data><data key="e_explanation">Shelter Cluster flagged increased landslide/debris-flow potential associated with seismic weakening of slopes compounded by rains.</data></edge>
<edge id="e14" source="displacement" target="protection_risks"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Overcrowding in shelters, family separation and displacement heightened GBV and protection risks per UNFPA.</data></edge>
<edge id="e15" source="displacement" target="disease_outbreak_risk"><data key="e_relation">amplifies</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Overcrowded temporary camps with inadequate sanitation increase risk of diarrheal and vaccine-preventable diseases per PAHO.</data></edge>
<edge id="e16" source="economic_losses" target="livelihood_loss"><data key="e_relation">amplifies</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Extensive damage to commercial buildings and infrastructure disrupted small businesses, informal commerce and tourism per IFRC.</data></edge>
<edge id="e17" source="vuln_unreinforced_construction" target="collapsed_structures"><data key="e_relation">amplifies</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">ACAPS/IFRC note unreinforced construction and informal hillside settlements as pre-existing risk factors that amplified structural damage.</data></edge>
<edge id="e18" source="vuln_fragile_housing" target="collapsed_structures"><data key="e_relation">amplifies</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">medium</data><data key="e_explanation">62% of housing already in fragile condition with repair needs increased susceptibility to earthquake damage.</data></edge>
<edge id="e19" source="vuln_preexisting_crisis" target="livelihood_loss"><data key="e_relation">amplifies</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Pre-existing economic crisis and high inflation limit recovery capacity and amplify livelihood losses per IFRC.</data></edge>
<edge id="e20" source="vuln_poverty" target="need_shelter"><data key="e_relation">amplifies</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">medium</data><data key="e_explanation">High poverty (94% in La Guaira) limits households' ability to self-recover, increasing shelter needs.</data></edge>
<edge id="e21" source="vuln_weak_services" target="need_water_sanitation"><data key="e_relation">amplifies</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">REACH found weak pre-existing water, shelter and health systems in affected states limiting absorptive capacity, worsening water needs.</data></edge>
<edge id="e22" source="vuln_weak_health_system" target="health_system_strain"><data key="e_relation">amplifies</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Pre-crisis shortages of personnel, medicines and surgical capacity compounded the health system's strain post-quake.</data></edge>
<edge id="e23" source="vuln_workforce_gap" target="need_livelihoods_investment"><data key="e_relation">amplifies</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">IRC notes mass emigration left workforce gaps that constrain search-and-rescue and recovery capacity, increasing need for economic investment.</data></edge>
<edge id="e24" source="vuln_low_protection_coverage" target="protection_risks"><data key="e_relation">amplifies</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">medium</data><data key="e_explanation">Low pre-existing Protection Cluster coverage (8% of target) limited capacity to address heightened post-quake protection risks.</data></edge>
<edge id="e25" source="vuln_censorship" target="need_registration_tracking"><data key="e_relation">amplifies</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">medium</data><data key="e_explanation">ACAPS notes censorship and limited transparency hinder situational awareness and complicate coordination, worsening registration/tracking gaps.</data></edge>
<edge id="e26" source="m_building_code_enforcement" target="collapsed_structures"><data key="e_relation">prevents</data><data key="e_drm_phase">prevention</data><data key="e_status">lacking</data><data key="e_confidence">high</data><data key="e_explanation">ACAPS reports lack of enforcement of building standards, meaning this preventive measure was absent and failed to prevent collapses.</data></edge>
<edge id="e27" source="deaths" target="need_registration_tracking"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">medium</data><data key="e_explanation">PAHO noted persistent gaps in registration and follow-up of deaths/injuries likely causing underestimation of casualties.</data></edge>
<edge id="e28" source="displacement" target="need_shelter"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Families displaced from damaged homes are staying in streets, cars and makeshift tents, generating urgent shelter needs.</data></edge>
<edge id="e29" source="infrastructure_disruption" target="need_water_sanitation"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Damage to water infrastructure combined with pre-existing weak systems created critical water and sanitation needs per Health Cluster.</data></edge>
<edge id="e30" source="health_system_strain" target="need_health_personnel"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Overwhelmed hospitals generated need for specialized medical personnel, medicines and equipment per Health Cluster.</data></edge>
<edge id="e31" source="deaths" target="need_mhpss"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Widespread fear, grief and distress from deaths and displacement generated critical MHPSS needs per Health Cluster.</data></edge>
<edge id="e32" source="displacement" target="need_child_protection"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Unaccompanied children identified in health centers required activation of protection pathways.</data></edge>
<edge id="e33" source="protection_risks" target="need_srh_gbv"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Heightened protection risks in overcrowded shelters drove UNFPA's identification of unmet SRH and GBV service needs.</data></edge>
<edge id="e34" source="vuln_unreinforced_construction" target="need_structural_assessment"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">medium</data><data key="e_explanation">ACAPS warns buildings that did not collapse may have unseen structural damage, requiring structural safety assessment before safe return.</data></edge>
<edge id="e35" source="logistics_congestion" target="need_logistics_coordination"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Congestion at airport/port and fuel shortages generated need for logistics coordination per OCHA LWG.</data></edge>
<edge id="e36" source="landslide_risk" target="need_landslide_monitoring"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Shelter Cluster identified need for daily rainfall/landslide monitoring and mapping given seismic weakening of slopes.</data></edge>
<edge id="e37" source="disease_outbreak_risk" target="need_vaccine_security"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">PAHO identified need to strengthen vaccine supply, cold chain and immunization to mitigate outbreak risk.</data></edge>
<edge id="e38" source="livelihood_loss" target="need_livelihoods_investment"><data key="e_relation">causes</data><data key="e_drm_phase">none</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">IRC warns loss of livelihoods and disrupted economies necessitate urgent investment to prevent deeper crisis.</data></edge>
<edge id="e39" source="m_sar_operations" target="deaths"><data key="e_relation">mitigates</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Venezuelan Red Cross and international USAR/UNDAC teams conducted search and rescue to save lives after the earthquakes.</data></edge>
<edge id="e40" source="m_state_emergency" target="collapsed_structures"><data key="e_relation">mitigates</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">medium</data><data key="e_explanation">Declaration of national emergency and disaster zone designation enabled prioritized response in the hardest-hit La Guaira state.</data></edge>
<edge id="e41" source="m_access_restrictions" target="deaths"><data key="e_relation">mitigates</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">medium</data><data key="e_explanation">Temporary access restrictions to La Guaira prioritized search and rescue efforts to save lives.</data></edge>
<edge id="e42" source="m_health_cluster_activation" target="need_health_personnel"><data key="e_relation">addresses</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Expanded Health Cluster consolidated a single response mechanism integrating actors to optimize health operations on the ground.</data></edge>
<edge id="e43" source="m_dref_emergency_appeal" target="need_shelter"><data key="e_relation">addresses</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">medium</data><data key="e_explanation">IFRC DREF/Emergency Appeal funding targeted 300,000 people for relief including shelter support.</data></edge>
<edge id="e44" source="m_field_hospital" target="health_system_strain"><data key="e_relation">mitigates</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Field hospital at Jorge García Carmeiro Stadium added surge capacity to relieve overwhelmed hospitals.</data></edge>
<edge id="e45" source="m_unhcr_protection_shelter" target="need_shelter"><data key="e_relation">addresses</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">UNHCR scaling up protection, core relief items and shelter support for 30,000 affected people.</data></edge>
<edge id="e46" source="m_unhcr_protection_shelter" target="need_child_protection"><data key="e_relation">addresses</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">medium</data><data key="e_explanation">UNHCR provides tools and equipment for identifying protection needs and facilitating referrals, including for children.</data></edge>
<edge id="e47" source="m_unfpa_srh_gbv_response" target="need_srh_gbv"><data key="e_relation">addresses</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">UNFPA scaling up SRH and GBV prevention/response services directly addresses identified survivor-centred service gaps.</data></edge>
<edge id="e48" source="m_unicef_response" target="need_water_sanitation"><data key="e_relation">addresses</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">medium</data><data key="e_explanation">UNICEF's $65.7M appeal addresses health, WASH, protection and education needs for 470,000 people including children.</data></edge>
<edge id="e49" source="m_ngo_relief" target="need_mhpss"><data key="e_relation">addresses</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">medium</data><data key="e_explanation">Project HOPE and other NGOs conducted assessments and identified significant MHPSS gaps needing response.</data></edge>
<edge id="e50" source="m_logistics_working_group" target="need_logistics_coordination"><data key="e_relation">addresses</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">OCHA LWG provides shared logistics services and information to address congestion and access constraints.</data></edge>
<edge id="e51" source="m_paho_medical_supplies" target="need_health_personnel"><data key="e_relation">addresses</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">PAHO/WHO delivered medical supplies and equipment to hospitals including Maternal and Child Hospital Leopoldo Aguerrevere.</data></edge>
<edge id="e52" source="m_needs_assessments" target="need_registration_tracking"><data key="e_relation">addresses</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">medium</data><data key="e_explanation">Rapid needs assessments by UNDAC/REACH/Project HOPE aim to consolidate evaluations and guide response, addressing data/registration gaps.</data></edge>
<edge id="e53" source="m_hrp_addendum" target="need_livelihoods_investment"><data key="e_relation">addresses</data><data key="e_drm_phase">recovery</data><data key="e_status">planned</data><data key="e_confidence">medium</data><data key="e_explanation">OCHA HRP Addendum and UNICEF HAC Addendum outline sector plans targeting 1.3 million affected people including recovery-oriented support.</data></edge>
<edge id="e54" source="m_health_facility_rehab" target="health_system_strain"><data key="e_relation">mitigates</data><data key="e_drm_phase">recovery</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Rehabilitation planning and restoration of ICU/maternity capacity at Hospital Dr. José Gregorio Hernández reduces ongoing health system strain.</data></edge>
<edge id="e55" source="m_revolving_fund_vaccines" target="need_vaccine_security"><data key="e_relation">addresses</data><data key="e_drm_phase">recovery</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">USD 18 million PAHO Revolving Fund credit line directly supports national vaccine supply security.</data></edge>
<edge id="e56" source="m_environmental_guidance" target="landslide_risk"><data key="e_relation">mitigates</data><data key="e_drm_phase">response</data><data key="e_status">recommended</data><data key="e_confidence">medium</data><data key="e_explanation">Shelter Cluster recommends environmental screening, sustainable siting and daily rainfall/landslide monitoring to reduce environmental and landslide harms.</data></edge>
<edge id="e57" source="m_rainfall_landslide_monitoring" target="need_landslide_monitoring"><data key="e_relation">addresses</data><data key="e_drm_phase">preparedness</data><data key="e_status">recommended</data><data key="e_confidence">high</data><data key="e_explanation">Shelter Cluster recommended daily monitoring of rainfall/landslide risk and landslide/debris-flow mapping as a preparedness measure.</data></edge>
<edge id="e58" source="m_tsunami_advisory" target="deaths"><data key="e_relation">mitigates</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">low</data><data key="e_explanation">A brief Caribbean tsunami advisory was issued and then cancelled, indicating functioning monitoring capacity during the event.</data></edge>
<edge id="e59" source="m_livelihoods_investment" target="need_livelihoods_investment"><data key="e_relation">mitigates</data><data key="e_drm_phase">recovery</data><data key="e_status">recommended</data><data key="e_confidence">high</data><data key="e_explanation">IRC recommends urgent investment in local economies and livelihood support during the early recovery window to prevent deepening crisis.</data></edge>
<edge id="e60" source="act_venezuelan_red_cross" target="m_sar_operations"><data key="e_relation">implements</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Venezuelan Red Cross began search-and-rescue in the Capital District on 24 June.</data></edge>
<edge id="e61" source="act_ifrc" target="m_dref_emergency_appeal"><data key="e_relation">implements</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">IFRC allocated DREF funding and launched the Emergency Appeal in support of the Venezuelan Red Cross.</data></edge>
<edge id="e62" source="act_venezuelan_red_cross" target="m_field_hospital"><data key="e_relation">implements</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">Venezuelan Red Cross set up the field hospital and Field Operations Centre.</data></edge>
<edge id="e63" source="act_unhcr" target="m_unhcr_protection_shelter"><data key="e_relation">implements</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">UNHCR is scaling up protection and shelter support as described in its emergency update and preparedness/response documents.</data></edge>
<edge id="e64" source="act_unfpa" target="m_unfpa_srh_gbv_response"><data key="e_relation">implements</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">UNFPA is scaling up SRH and GBV response per its Flash Update and Country Appeal.</data></edge>
