<edge id="e71" source="act_ocha" target="m_hrp_addendum"><data key="e_relation">implements</data><data key="e_drm_phase">recovery</data><data key="e_status">planned</data><data key="e_confidence">high</data><data key="e_explanation">OCHA produced the Humanitarian Response Plan Addendum outlining sector plans for the earthquake response.</data></edge>
