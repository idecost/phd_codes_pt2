<edge id="e67" source="act_paho_who" target="m_paho_medical_supplies"><data key="e_relation">implements</data><data key="e_drm_phase">response</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">PAHO/WHO delivered medical supplies and equipment to affected health facilities.</data></edge>
<edge id="e68" source="act_paho_who" target="m_revolving_fund_vaccines"><data key="e_relation">implements</data><data key="e_drm_phase">recovery</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">PAHO's Revolving Fund credit line supports national vaccine supply security as reported in Sitrep No.9.</data></edge>
<edge id="e69" source="act_paho_who" target="m_health_facility_rehab"><data key="e_relation">implements</data><data key="e_drm_phase">recovery</data><data key="e_status">observed</data><data key="e_confidence">high</data><data key="e_explanation">PAHO Sitrep No.9 reports rehabilitation planning and restoration of hospital capacity as part of early recovery efforts.</data></edge>
